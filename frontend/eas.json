{
    "cli": {
        "version": ">= 5.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "image": "latest"
            },
            "ios": {
                "simulator": true,
                "image": "latest"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "image": "latest"
            },
            "ios": {
                "image": "latest"
            }
        },
        "production": {
            "android": {
                "buildType": "apk",
                "image": "latest",
                "gradleCommand": ":app:assembleRelease"
            },
            "ios": {
                "image": "latest"
            },
            "cache": {
                "disabled": true
            },
            "env": {
                "EXPO_NO_CAPABILITY_SYNC": "1"
            }
        },
        "production-aab": {
            "android": {
                "buildType": "app-bundle",
                "image": "latest"
            }
        }
    },
    "submit": {
        "production": {}
    }
}