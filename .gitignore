# Root .gitignore for ElBaraka project

# Environment files
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.backup
*.bak
.tmp_*

# Local DB backups pulled from prod (NEVER commit dumps — they contain PII).
backups/
session.txt

# Documentation (optional - uncomment if you don't want to track these)
# IMPLEMENTATION_SUMMARY.md
# TESTING_CHECKLIST.md
# SETUP_AND_TESTING_GUIDE.md
